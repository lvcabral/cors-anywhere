{
  "name": "cors-anywhere",
  "version": "0.5.0",
  "description": "CORS Anywhere is a reverse proxy which adds CORS headers to the proxied request. Request URL is taken from the path",
  "license": "MIT",
  "author": "Rob Wu <rob@robwu.nl>",
  "contributors": [
    "Marcelo Lv Cabral <marcelo@lvcabral.com>"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Rob--W/cors-anywhere.git"
  },
  "bugs": {
    "url": "https://github.com/Rob--W/cors-anywhere/issues/",
    "email": "rob@robwu.nl"
  },
  "keywords": [
    "cors",
    "cross-domain",
    "http-proxy",
    "proxy",
    "heroku"
  ],
  "main": "./lib/cors-anywhere.js",
  "files": [
    "lib/",
    "test/",
    "Procfile",
    "demo.html",
    "server.js"
  ],
  "dependencies": {
    "http-proxy": "^1.18.1",
    "proxy-from-env": "0.0.1"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "lolex": "^6.0.0",
    "mocha": "^10.7.3",
    "nock": "^13.5.5",
    "nyc": "^17.1.0",
    "supertest": "^7.0.0"
  },
  "scripts": {
    "lint": "eslint .",
    "test": "mocha ./test/test*.js --reporter spec",
    "test-coverage": "nyc mocha test/test.js test/test-ratelimit.js --reporter spec && nyc report --reporter=text-summary && rm -rf .nyc_output"
  },
  "engines": {
    "node": ">=0.10.0"
  }
}
